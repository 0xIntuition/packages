{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"incremental": false,
		"allowJs": false,
		"checkJs": false,
		"declaration": true,
		"declarationMap": true,
		"outDir": "dist"
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts", "**/__tests__/**"]
}
