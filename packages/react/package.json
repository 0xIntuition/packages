{
	"name": "@0xintuition/react",
	"version": "0.1.0-alpha.1",
	"description": "React hooks for core Intuition protocol interactions",
	"private": false,
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"intuition",
		"react",
		"hooks",
		"wagmi"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0xIntuition/packages.git",
		"directory": "packages/react"
	},
	"bugs": {
		"url": "https://github.com/0xIntuition/packages/issues"
	},
	"homepage": "https://github.com/0xIntuition/packages/tree/main/packages/react#readme",
	"publishConfig": {
		"access": "public",
		"tag": "alpha"
	},
	"scripts": {
		"build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node ../../scripts/normalize-dist-imports.mjs",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsc --watch",
		"pack:dry-run": "bun run build && npm pack --ignore-scripts --dry-run --json",
		"pack:release": "bun run build && node ../../scripts/pack-release.mjs",
		"prepack": "bun run build",
		"prepublishOnly": "bun run build && node ../../scripts/guard-direct-publish.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"ci": "biome check",
		"lint": "biome lint",
		"format": "biome format",
		"check": "biome check",
		"lint:write": "biome lint --write",
		"format:write": "biome format --write",
		"check:write": "biome check --write",
		"check:unsafe:write": "biome check --write --unsafe"
	},
	"dependencies": {
		"@0xintuition/deployments": "0.1.0-alpha.0",
		"@0xintuition/ids": "0.1.0-alpha.0",
		"@0xintuition/protocol": "3.1.0"
	},
	"peerDependencies": {
		"@tanstack/react-query": ">=5",
		"react": ">=18",
		"viem": "^2.0.0",
		"wagmi": ">=2"
	},
	"devDependencies": {
		"typescript": "^5.9.3",
		"vitest": "^4.0.16",
		"@tanstack/react-query": "^5.90.2",
		"@testing-library/react": "^16.3.0",
		"@types/react": "19.1.10",
		"jsdom": "^26.1.0",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"viem": "^2.31.4",
		"wagmi": "^2.15.4"
	}
}
