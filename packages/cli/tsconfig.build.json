{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"incremental": false,
		"allowJs": false,
		"checkJs": false,
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"outDir": "dist",
		"rootDir": "src"
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist", "scripts", "**/*.test.ts", "**/*.test-helpers.ts"]
}
