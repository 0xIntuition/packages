{
	"name": "@0xintuition/primitives",
	"version": "0.1.0-alpha.1",
	"description": "High-level Intuition atom, claim, and validation primitives",
	"private": false,
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json",
		"./atom": {
			"types": "./dist/atom.d.ts",
			"import": "./dist/atom.js"
		},
		"./predicate": {
			"types": "./dist/predicate.d.ts",
			"import": "./dist/predicate.js"
		},
		"./triple": {
			"types": "./dist/triple.d.ts",
			"import": "./dist/triple.js"
		},
		"./discover": {
			"types": "./dist/discover.d.ts",
			"import": "./dist/discover.js"
		},
		"./validate": {
			"types": "./dist/validate.d.ts",
			"import": "./dist/validate.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js"
		},
		"./anchor": {
			"types": "./dist/anchor.d.ts",
			"import": "./dist/anchor.js"
		}
	},
	"keywords": [
		"intuition",
		"primitives",
		"atoms",
		"claims"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0xIntuition/packages.git",
		"directory": "packages/primitives"
	},
	"bugs": {
		"url": "https://github.com/0xIntuition/packages/issues"
	},
	"homepage": "https://github.com/0xIntuition/packages/tree/main/packages/primitives#readme",
	"publishConfig": {
		"access": "public",
		"tag": "alpha"
	},
	"scripts": {
		"build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node ../../scripts/normalize-dist-imports.mjs",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsc --watch",
		"pack:dry-run": "bun run build && npm pack --ignore-scripts --dry-run --json",
		"pack:release": "bun run build && node ../../scripts/pack-release.mjs",
		"prepack": "bun run build",
		"prepublishOnly": "bun run build && node ../../scripts/guard-direct-publish.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"ci": "biome check",
		"lint": "biome lint",
		"format": "biome format",
		"check": "biome check",
		"lint:write": "biome lint --write",
		"format:write": "biome format --write",
		"check:write": "biome check --write",
		"check:unsafe:write": "biome check --write --unsafe"
	},
	"dependencies": {
		"@0xintuition/classifications": "0.1.0-alpha.1",
		"@0xintuition/ids": "0.1.0-alpha.0",
		"@0xintuition/iid": "0.1.0-alpha.0",
		"@0xintuition/iid-registry": "0.1.0-alpha.0",
		"@0xintuition/predicates": "0.1.0-alpha.0"
	},
	"peerDependencies": {
		"viem": "^2.0.0"
	},
	"devDependencies": {
		"typescript": "^5.9.3",
		"vitest": "^4.0.16",
		"viem": "^2.31.4"
	}
}
