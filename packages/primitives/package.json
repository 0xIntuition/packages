{
	"name": "@0xintuition/primitives",
	"version": "0.1.0-alpha.0",
	"description": "High-level Intuition atom, claim, and validation primitives",
	"private": false,
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"types": "./src/index.ts",
	"files": [
		"src",
		"README.md"
	],
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json",
		"./atom": "./src/atom.ts",
		"./predicate": "./src/predicate.ts",
		"./triple": "./src/triple.ts",
		"./discover": "./src/discover.ts",
		"./validate": "./src/validate.ts",
		"./types": "./src/types.ts"
	},
	"keywords": [
		"intuition",
		"primitives",
		"atoms",
		"claims"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0xIntuition/packages.git",
		"directory": "packages/primitives"
	},
	"bugs": {
		"url": "https://github.com/0xIntuition/packages/issues"
	},
	"homepage": "https://github.com/0xIntuition/packages/tree/main/packages/primitives#readme",
	"publishConfig": {
		"access": "public",
		"tag": "alpha"
	},
	"scripts": {
		"build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node ../../scripts/normalize-dist-imports.mjs",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "tsc --watch",
		"pack:dry-run": "bun run build && node ../../scripts/pack-release.mjs --dry-run --json --dist-entrypoints --rewrite-workspace-deps",
		"pack:release": "bun run build && node ../../scripts/pack-release.mjs --dist-entrypoints --rewrite-workspace-deps",
		"prepack": "bun run build",
		"prepublishOnly": "node ../../scripts/guard-direct-publish.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"ci": "biome check",
		"lint": "biome lint",
		"format": "biome format",
		"check": "biome check",
		"lint:write": "biome lint --write",
		"format:write": "biome format --write",
		"check:write": "biome check --write",
		"check:unsafe:write": "biome check --write --unsafe"
	},
	"dependencies": {
		"@0xintuition/classifications": "workspace:*",
		"@0xintuition/ids": "workspace:*",
		"@0xintuition/predicates": "workspace:*"
	},
	"peerDependencies": {
		"viem": "^2.0.0"
	},
	"devDependencies": {
		"typescript": "catalog:",
		"vitest": "catalog:",
		"viem": "catalog:"
	}
}
