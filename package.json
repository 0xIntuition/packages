{
	"name": "@0xintuition/packages-monorepo",
	"version": "0.0.0",
	"private": true,
	"description": "Public Intuition packages monorepo for alpha package publication.",
	"license": "MIT",
	"type": "module",
	"packageManager": "bun@1.3.3",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"check": "turbo run check",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"clean": "turbo run clean",
		"schema:validate": "node scripts/validate-schema.mjs",
		"schema:verify-live": "node scripts/verify-live-schema.mjs",
		"predicates:check-generated": "node scripts/check-predicate-generation.mjs",
		"pack:dry-run": "node scripts/pack-dry-run.mjs",
		"smoke:tarballs": "node scripts/smoke-tarballs.mjs",
		"guard:supply-chain": "node scripts/guard-supply-chain-policy.mjs",
		"preinstall": "node scripts/enforce-bun-install.mjs"
	},
	"catalog": {
		"@biomejs/biome": "2.3.10",
		"@tanstack/react-query": "^5.90.2",
		"@testing-library/react": "^16.3.0",
		"@types/bun": "^1.3.3",
		"@types/react": "19.1.10",
		"@types/react-dom": "19.2.0",
		"jsdom": "^26.1.0",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"turbo": "^2.6.2",
		"typescript": "^5.9.3",
		"viem": "^2.31.4",
		"vitest": "^4.0.16",
		"wagmi": "^2.15.4"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/bun": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=20"
	}
}
